{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-copilot/schemas/metric-parameter-contract.schema.json",
  "title": "FundMetricParameterContract",
  "description": "Schema for fund metric parameter contracts",
  "type": "object",
  "required": [
    "mnemonic",
    "parameters",
    "result",
    "parameter_schema_version",
    "contract_status"
  ],
  "properties": {
    "mnemonic": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "index_name": {
      "type": "string"
    },
    "parent_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "embedding_text": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "enabled": {
      "type": "boolean"
    },
    "source_indicator_id": {
      "type": "integer"
    },
    "supported_usage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicable_products": {
      "type": "string"
    },
    "authoritative_code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "result": {
      "$ref": "#/$defs/resultContract"
    },
    "result_value_type": {
      "type": "string"
    },
    "parameter_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "INFERRED",
        "REVIEWED",
        "NEEDS_REVIEW"
      ]
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": [
        "position",
        "key",
        "valueType",
        "required"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "valueType": {
          "type": "string",
          "enum": [
            "STRING",
            "DATE",
            "INTEGER",
            "DECIMAL",
            "BOOLEAN",
            "ENUM"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "semanticType": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "defaultValue": {},
        "format": {
          "type": "string"
        },
        "pairWith": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/enumOption"
          }
        }
      },
      "additionalProperties": true
    },
    "enumOption": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "resultContract": {
      "type": "object",
      "required": [
        "valueType",
        "supportedOperators"
      ],
      "properties": {
        "valueType": {
          "type": "string",
          "enum": [
            "STRING",
            "DATE",
            "INTEGER",
            "DECIMAL",
            "BOOLEAN",
            "ENUM"
          ]
        },
        "precision": {
          "type": "object",
          "required": [
            "totalDigits",
            "scale",
            "roundingMode"
          ],
          "properties": {
            "totalDigits": {
              "type": "integer",
              "minimum": 1
            },
            "scale": {
              "type": "integer",
              "minimum": 0
            },
            "roundingMode": {
              "type": "string"
            }
          }
        },
        "displayScale": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "supportedOperators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              ">",
              ">=",
              "<",
              "<=",
              "=",
              "!="
            ]
          }
        },
        "storageConvention": {
          "type": "string"
        },
        "acceptedInputUnits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "unit",
              "multiplier"
            ],
            "properties": {
              "unit": {
                "type": "string"
              },
              "multiplier": {
                "type": "number"
              }
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/enumOption"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
