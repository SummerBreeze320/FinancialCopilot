                    "en-US": "90-120D"
                  }
                },
                {
                  "value": "120-397天",
                  "valueI18n": {
                    "en-US": "120-397D"
                  }
                }
              ],
              "fixed": 2
            },
            "xAxis": {
              "data": [
                "reportDate"
              ],
              "format": "quarter"
            }
          },
          "legend": {
            "show": true
          },
          "options": {
            "grid": {
              "bottom": 0
            },
            "yAxis": {
              "min": 0,
              "max": 100,
              "interval": 20,
              "axisLabel": {
                "formatter": "{value}%"
              }
            }
          }
        },
        "card": {
          "title": "历年剩余期限分布",
          "width": "24",
          "height": "380px"
        }
      }
    },
    {
