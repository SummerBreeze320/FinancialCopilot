{
  "toolId": "fund_analysis_run_indicators",
  "name": "单基金历年运行指标变动",
  "scope": "ANALYSIS",
  "toolType": "ANALYSIS_TOOL",
  "description": "追踪基金历年规模变动、久期/平均剩余期限、剩余期限分布、杠杆率变动及偏离度指标",
  "provider": "http_invoke",
  "server": null,
  "targetTool": null,
  "templateId": null,
  "parameters": [
    {
      "name": "windCodes",
      "type": "array[string]",
      "required": true,
      "defaultValue": null,
      "description": "入参: windCodes"
    },
    {
      "name": "startDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: startDate"
    },
    {
      "name": "endDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: endDate"
    },
    {
      "name": "type",
      "type": "string",
      "required": false,
      "defaultValue": "1",
      "description": "入参: type"
    },
    {
      "name": "reportDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: reportDate"
    }
  ],
  "componentCount": 6,
  "components": [
    {
      "componentId": "MoneyHistoryScaleChange",
      "name": "历年规模变化",
      "cardTitle": "历年规模变化",
      "displayType": "chart:bar",
      "description": "展示基金历年规模变化柱状图",
      "command": "FundCompare.FundHistoryChangePicker.GetData",
      "params": [
        "windCodes",
        "startDate",
        "endDate",
        "type:1"
      ],
      "columns": {
        "Object/windCode": "windCode",
        "Object/name": "name",
        "Object/list/reportDate": "reportDate",
        "Object/list/value": "value"
      },
      "metadata": {
        "bar": {
          "columns": {
            "series": {
              "reportDate": [
                "value"
              ]
            },
            "xAxis": {
              "data": [
                "reportDate"
              ]
            }
          },
          "options": {},
          "legend": {
            "show": false
          },
          "yAxis": {
            "name": "亿元",
            "nameLocation": "middle"
          },
          "extra": [
            {
              "name": [
                "merge"
              ],
              "type": "radio",
              "radio": {
                "合计规模": 0,
                "合计份额": 1
              }
            }
          ]
        },
        "card": {
          "title": "历年规模变化",
          "width": "24",
          "height": "380px"
        }
      }
    },
    {
      "componentId": "MoneyHistoryATMChart",
      "name": "历年平均剩余期限",
      "cardTitle": "历年平均剩余期限",
      "displayType": "chart:mixed",
      "description": "展示基金历年平均剩余期限",
      "command": "report name=Fund.AssetPortfolio.PortfolioResidualPeriod21 windCodes=[{windCodes}] startDate=[{startDate}] endDate=[{endDate}]",
      "params": [
        "windCodes",
        "startDate",
        "endDate"
      ],
      "columns": {
        "Column2": "reportDate",
        "Column3": "endData",
        "Column4": "maxData",
        "Column5": "minData",
        "Column6": "similarData"
      },
      "metadata": {
        "mixed": {
          "columns": {
            "series": {
              "reportDate": [
                "endData",
                "similarData"
              ],
              "xAxis": [
                {
                  "value": "期末",
                  "valueI18n": {
                    "en-US": "Period End"
                  }
                },
                {
                  "value": "同类",
                  "valueI18n": {
                    "en-US": "Peer Group"
                  }
                }
              ],
              "fixed": 0,
              "unit": "天"
            },
            "rangeSeries": {
              "name": "期内最低和最高",
              "min": "minData",
              "max": "maxData",
              "fixed": 0,
              "render": "errorBar",
              "lineWidth": 1
            },
            "xAxis": {
              "data": [
                "reportDate"
              ],
              "format": "quarter"
            }
          },
          "color": [
            "#2a7fa8",
            "#f68717",
            "#5fbebf"
          ],
          "legend": {
            "show": true,
            "bottom": 0,
            "left": "center",
            "icon": "circle"
          },
          "options": {
            "grid": {
              "bottom": 0
            },
            "yAxis": [
              {
                "type": "value",
                "position": "left",
                "name": "天",
                "nameLocation": "middle",
                "axisLabel": {
                  "fontSize": 12
                }
              },
              {
                "type": "value",
                "position": "right",
                "show": false
              }
            ]
          }
        },
        "card": {
          "title": "历年平均剩余期限",
          "width": "24",
          "height": "380px"
        }
      }
    },
    {
      "componentId": "MoneyHistoryRMDChart",
