  "componentCount": 6,
  "components": [
    {
      "componentId": "MoneySevenDayYieldChart",
      "name": "七日年化",
      "cardTitle": "七日年化",
      "displayType": "chart:line",
      "description": "展示基金七日年化走势图",
      "command": "FactSheet.Performance.FundReturnPicker.GetMultipleRecs",
      "params": [
        "windCodes",
        "startDate",
        "endDate",
        "circle:0",
        "rolling:0",
        "benchCode:[]",
        "indexs:[]",
        "type:0",
        "showMedian:1"
      ],
      "columns": {
        "Object/windCode": "windCode",
        "Object/name": "name",
        "Object/yieldList/date": "date",
        "Object/yieldList/value": "value"
      },
      "metadata": {
        "line": {
          "columns": {
            "series": {
              "name": [
                "value"
              ]
            },
            "xAxis": {
              "data": [
                "date"
              ]
            }
          },
          "options": {},
          "legend": {
            "show": true
          },
          "yAxis": {
            "axisLabel": {
              "formatter": "{value}%"
            }
          }
        },
        "card": {
          "title": "七日年化",
          "width": "24",
          "height": "380px"
        }
      }
    },
