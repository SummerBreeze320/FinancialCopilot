              ]
            },
            "xAxis": {
              "data": [
                "year"
              ]
            }
          },
          "yAxis": {
            "axisLabel": {
              "formatter": "{value}%"
            }
          },
          "options": {}
        },
        "card": {
          "title": "年度回报",
          "width": "24",
          "height": "380px"
        }
      }
    },
    {
      "componentId": "MoneyYearlyReturnTable",
      "name": "年度回报表",
      "cardTitle": "年度回报表",
      "displayType": "table",
      "description": "以表格展示近五年及YTD年度收益。",
      "command": "FundCompare.FundAnnualReturnPicker.GetData",
      "params": [
        "windCodes",
        "endDate",
        "indexCode",
        "hasPreTransitionFund:0"
      ],
      "columns": {
        "Object/windCode": "windCode",
        "Object/name": "name",
        "Object/annualReturnList/year": "year",
        "Object/annualReturnList/annualReturn": "annualReturn",
        "Object/annualReturnList/rank": "3YRank",
        "Object/annualReturnList/order": "sameTypeRank",
        "Object/annualReturnList/windThreeYears": "wind3YRank"
      },
      "metadata": {
        "table": {
          "transform": {
            "type": "pivot",
            "rowField": "year",
            "columnField": "name",
            "valueField": "annualReturn",
            "sort": {
              "field": "year",
              "order": "desc"
            },
            "extraFields": [
              {
                "field": "wind3YRank",
                "source": "firstNonEmpty"
              },
              {
                "field": "sameTypeRank",
                "source": "firstNonEmpty"
              }
            ]
          },
          "columns": [
            {
              "title": "年份",
              "type": "string",
              "id": "year"
            },
            {
              "title": "年化回报",
              "type": "number",
              "id": "annualReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            },
            {
              "title": "Wind三年评级",
              "type": "number",
              "id": "wind3YRank",
              "sorter": true,
              "starRender": true
            },
            {
              "title": "同类排名",
              "type": "number",
              "id": "sameTypeRank",
              "sorter": true
            }
          ]
        },
        "card": {
          "title": "年度回报表",
          "width": "24"
        }
      }
    }
