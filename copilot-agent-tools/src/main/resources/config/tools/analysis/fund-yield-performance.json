      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: endDate"
    },
    {
      "name": "circle",
      "type": "string",
      "required": false,
      "defaultValue": "0",
      "description": "入参: circle"
    },
    {
      "name": "rolling",
      "type": "string",
      "required": false,
      "defaultValue": "0",
      "description": "入参: rolling"
    },
    {
      "name": "benchCode",
      "type": "string",
      "required": false,
      "defaultValue": "[]",
      "description": "入参: benchCode"
    },
    {
      "name": "indexs",
      "type": "string",
      "required": false,
      "defaultValue": "[]",
      "description": "入参: indexs"
    },
    {
      "name": "type",
      "type": "string",
      "required": false,
      "defaultValue": "0",
      "description": "入参: type"
    },
    {
      "name": "showMedian",
      "type": "string",
      "required": false,
      "defaultValue": "1",
      "description": "入参: showMedian"
    },
    {
      "name": "hasPreTransitionFund",
      "type": "string",
      "required": false,
      "defaultValue": "0",
      "description": "入参: hasPreTransitionFund"
    },
    {
      "name": "frequency",
      "type": "string",
      "required": false,
      "defaultValue": "4",
      "description": "入参: frequency"
    },
    {
      "name": "indexCode",
