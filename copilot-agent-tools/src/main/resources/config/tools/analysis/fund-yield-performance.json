        "Object/annualReturnList/annualReturn": "annualReturn",
        "Object/annualReturnList/rank": "3YRank",
        "Object/annualReturnList/order": "sameTypeRank",
        "Object/annualReturnList/windThreeYears": "wind3YRank"
      },
      "metadata": {
        "bar": {
          "columns": {
            "series": {
              "name": [
