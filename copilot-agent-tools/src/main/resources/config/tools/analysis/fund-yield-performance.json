    {
      "componentId": "MoneyPerformanceChart",
      "name": "业绩表现",
      "cardTitle": "业绩表现",
      "displayType": "chart:line",
      "description": "展示基金业绩表现走势图",
      "command": "FundCompare.FundPerformanceChartPicker.GetData",
      "params": [
        "windCodes",
        "startDate",
        "endDate",
        "hasPreTransitionFund:0",
        "frequency:4",
        "indexCode"
      ],
      "columns": {
        "Object/windCode": "windCode",
        "Object/name": "name",
        "Object/yieldList/date": "date",
        "Object/yieldList/value": "value"
      },
      "metadata": {
        "line": {
          "transform": {
            "type": "highestLowest",
            "keyField": "windCode",
            "nameField": "name",
            "dateField": "date",
            "valueField": "value",
            "highestKey": "highest6",
            "lowestKey": "lowest6",
            "durationDays": 180,
            "formatterSuffix": "%",
            "fixed": 2
          },
          "columns": {
            "series": {
              "name": [
                "value"
              ]
            },
            "xAxis": {
              "data": [
                "date"
              ]
            }
          },
          "options": {},
          "legend": {
            "show": true
          },
          "yAxis": {
            "axisLabel": {
              "formatter": "{value}%"
            }
          }
        },
        "card": {
          "title": "业绩表现",
          "width": "24",
          "height": "380px"
        }
      }
    },
    {
      "componentId": "MoneyPerformanceTable",
      "name": "业绩表现表",
      "cardTitle": "业绩表现表",
      "displayType": "table",
      "description": "展示基金业绩表现表格",
      "command": "report name=FactSheet2.Fund.FundPerformanceNetValueTable21 windCode=[{windCodes}] date=[{endDate}] hasPreTransitionFund=[0] indexCode=[{indexCode}]",
      "params": [
        "windCodes",
        "endDate",
        "indexCode"
      ],
      "columns": {
        "Column0": "windCode",
        "Column1": "name",
        "Column2": "YTD",
        "Column4": "6MReturn",
        "Column5": "1YReturn",
        "Column6": "2YReturn",
        "Column7": "3YReturn",
        "Column8": "5YReturn",
        "Column9": "totalReturn",
        "Column10": "annualReturn",
        "Column12": "10YReturn"
      },
      "metadata": {
        "table": {
          "columns": [
            {
              "title": "基金名称",
              "type": "string",
              "id": "name"
            },
            {
              "title": "YTD",
              "type": "number",
              "id": "ytdReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            },
            {
              "title": "近六月",
              "type": "number",
              "id": "6MReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            },
            {
              "title": "近一年",
              "type": "number",
              "id": "1YReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            },
            {
              "title": "近两年",
              "type": "number",
              "id": "2YReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            },
            {
              "title": "近三年",
              "type": "number",
              "id": "3YReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            },
            {
              "title": "近五年",
              "type": "number",
              "id": "5YReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            },
            {
              "title": "近十年",
              "type": "number",
              "id": "10YReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            },
            {
              "title": "总回报",
              "type": "number",
              "id": "totalReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            },
            {
              "title": "年化回报",
              "type": "number",
              "id": "annualReturn",
              "sorter": true,
              "signColor": true,
              "unit": "%",
              "fixed": 2
            }
          ]
        },
        "card": {
          "title": "业绩表现表",
          "width": "24"
        }
      }
    },
    {
      "componentId": "MoneyYearlyReturnChart",
      "name": "年度回报",
      "cardTitle": "年度回报",
      "displayType": "chart:bar",
      "description": "以柱状图展示近五年及YTD年度收益。",
      "command": "FundCompare.FundAnnualReturnPicker.GetData",
      "params": [
        "windCodes",
        "endDate",
        "indexCode",
        "hasPreTransitionFund:0"
      ],
      "columns": {
        "Object/windCode": "windCode",
        "Object/name": "name",
