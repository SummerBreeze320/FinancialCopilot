    {
      "name": "windCodes",
      "type": "array[string]",
      "required": true,
      "defaultValue": null,
      "description": "入参: windCodes"
    },
    {
      "name": "reportDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: reportDate"
    },
    {
      "name": "startDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: startDate"
    },
    {
      "name": "endDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: endDate"
    }
  ],
  "componentCount": 2,
  "components": [
    {
      "componentId": "MoneyAssetAllocationChart",
      "name": "资产配置",
      "cardTitle": "资产配置",
      "displayType": "chart:stackedBar",
      "description": "展示基金资产配置堆积图",
      "command": "report name=FactSheet2.Nav.FundAssetsOfPastYears21 windCode=[{windCodes}] date=[{reportDate}] sort=[7=asc,0=asc]",
      "params": [
        "windCodes",
        "reportDate"
      ],
      "columns": {
        "Column0": "reportDate",
        "Column1": "stockRatio",
        "Column2": "bondRatio",
        "Column3": "fundRatio",
        "Column5": "currencyRatio",
        "Column6": "otherRatio",
        "Column7": "windCode"
      },
      "metadata": {
        "stackedBar": {
          "columns": {
            "series": {
              "reportDate": [
                "stockRatio",
                "bondRatio",
                "fundRatio",
                "currencyRatio",
                "otherRatio"
              ],
