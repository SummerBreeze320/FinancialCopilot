{
  "toolId": "fund_analysis_asset_allocation",
  "name": "单基金大类与债券资产配置",
  "scope": "ANALYSIS",
  "toolType": "ANALYSIS_TOOL",
  "description": "分析单只基金的资产配置比例与债券券种配置结构",
  "provider": "http_invoke",
  "server": null,
  "targetTool": null,
  "templateId": null,
