              "unit": "只"
            },
            {
              "title": "在管基金规模",
              "type": "number",
              "id": "manageFundScale",
              "multiply": 1e-08,
              "fixed": 2,
              "unit": "亿元"
            },
            {
              "title": "投资经理年限",
              "type": "number",
              "id": "totalPostYears",
