{
  "toolId": "compare_manager",
  "name": "多基金经理背景对比",
  "scope": "COMPARISON",
  "toolType": "COMPARISON_TOOL",
  "description": "横向对比多位基金经理的在管规模、从业年限、旗下产品数及擅长领域",
  "provider": "http_invoke",
  "server": null,
  "targetTool": null,
