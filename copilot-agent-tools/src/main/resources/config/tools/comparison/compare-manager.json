      "type": "array[string]",
      "required": true,
      "defaultValue": null,
      "description": "入参: windCodes"
    },
    {
      "name": "endDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: endDate"
    }
  ],
  "componentCount": 1,
  "components": [
    {
      "componentId": "FundManagerBasic",
      "name": "基金经理基本资料",
      "cardTitle": "基金经理基本资料",
      "displayType": "table",
      "description": "以表格形式展示{windCodes}基金的基金经理资料数据，包括基金经理、基金公司、擅长领域、在管基金只数、在管基金规模、投资经理年限，截止日期：{endDate}",
      "command": "FundCompare.FundManagerPicker.GetMultipleRecs",
      "params": [
        "windCodes",
        "endDate"
      ],
      "columns": {
        "Object/WindCode": "fundCode",
        "Object/FundName": "fundName",
        "Object/Managers/ManagerId": "managerId",
        "Object/Managers/ManagerName": "managerName",
        "Object/Managers/CompanyId": "companyId",
        "Object/Managers/CompanyName": "companyName",
        "Object/Managers/FirstInvestType": "specialization",
        "Object/Managers/ManagedFundNum": "managedFundNum",
        "Object/Managers/ManageScale": "manageFundScale",
        "Object/Managers/TotalPostYears": "totalPostYears",
        "Object/Managers/PostFundGeometryReturn": "postReturn"
      },
      "metadata": {
        "table": {
          "columns": [
            {
              "title": "",
              "type": "string",
              "id": "managerId"
            },
            {
              "title": "基金经理",
              "type": "string",
              "id": "managerName"
            },
            {
              "title": "基金公司",
              "type": "string",
              "id": "companyName"
            },
            {
              "title": "擅长领域",
              "type": "string",
              "id": "specialization"
            },
            {
              "title": "在管基金只数",
