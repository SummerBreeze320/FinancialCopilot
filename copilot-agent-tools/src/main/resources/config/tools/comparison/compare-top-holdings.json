{
  "toolId": "compare_top_holdings",
  "name": "多基金重仓资产对标",
  "scope": "COMPARISON",
  "toolType": "COMPARISON_TOOL",
  "description": "横向对标多只基金的前十大重仓股票、债券券种配置、重仓债券明细及重仓基金",
  "provider": "http_invoke",
  "server": null,
  "targetTool": null,
  "templateId": null,
  "parameters": [
    {
      "name": "windCodes",
      "type": "array[string]",
      "required": true,
      "defaultValue": null,
      "description": "入参: windCodes"
    },
    {
      "name": "reportDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: reportDate"
    }
  ],
  "componentCount": 4,
  "components": [
    {
      "componentId": "TopHoldings",
      "name": "重仓股票",
      "cardTitle": "重仓股票",
      "displayType": "MergedHeader",
      "description": "以表格形式展示{windCodes}基金的重仓股票数据，包括前N大重仓股票名称、占净值比、近三月涨幅，按基金分组展示，报告期：{reportDate}",
      "command": "MFCP.Report16Picker2.GetData",
      "params": [
        "windCodes",
        "reportDate"
      ],
      "columns": {
        "Object/windCode": "windCode",
        "Object/name": "name",
        "Object/reportDate": "reportDate",
        "Object/holdingList/StockCode": "stockCode",
        "Object/holdingList/StockName": "stockName",
        "Object/holdingList/NetPortion": "proportionToFundNet",
        "Object/holdingList/3MReturn": "3MStockReturn"
      },
      "metadata": {
        "MergedHeader": {
          "columns": [
            {
              "title": "",
              "id": "name",
              "children": [
                {
                  "title": "股票名称",
                  "type": "string",
                  "id": "stockName",
                  "href": "!CommandParam(1400,WindCode=$$stockCode)"
                },
                {
                  "title": "占净值比",
                  "type": "number",
                  "id": "proportionToFundNet",
                  "unit": "%",
                  "fixed": 2
                },
                {
                  "title": "近三月涨幅",
                  "type": "number",
                  "id": "3MStockReturn",
                  "unit": "%",
                  "fixed": 2
                }
              ]
            }
          ],
          "Notes": "注：红色代表当列中最高值；绿色代表当列中最低值"
        },
        "card": {
          "title": "重仓股票",
          "width": "24"
        }
      }
    },
    {
      "componentId": "BondTypeAllocation",
      "name": "债券券种配置",
      "cardTitle": "债券券种配置",
      "displayType": "table",
      "description": "以表格形式展示{windCodes}基金的债券券种配置数据，包括国债、金融债、可转债、企业债、企业短期融资、中期票据、央行票据、同业存单占比，报告期：{reportDate}",
      "command": "MFCP.Report18Picker",
      "params": [
        "windCodes",
        "reportDate"
      ],
      "columns": {
        "Object/WindCode": "windCode",
        "Object/FundName": "name",
        "Object/NationalDebtRatio": "nationalBondRatio",
        "Object/FinancialBondRatio": "financialBondRatio",
        "Object/ConvertiblelBondRatio": "convertiblelBondRatio",
        "Object/CorporateBondRatio": "enterpriseBondRatio",
        "Object/ShortBondRatio": "shortBondRatio",
        "Object/MediumPaperRatio": "mediumPaperRatio",
        "Object/CentralBankPaperRatio": "centralBankPaperRatio",
        "Object/InterBankPaperRatio": "interBankPaperRatio"
      },
      "metadata": {
        "table": {
          "columns": [
            {
              "title": "",
              "type": "string",
              "id": "name"
            },
            {
              "title": "国债",
              "type": "number",
              "id": "nationalBondRatio",
              "unit": "%",
              "sorter": true,
              "ColorRanking": true
            },
            {
              "title": "金融债",
              "type": "number",
              "id": "financialBondRatio",
              "unit": "%",
              "sorter": true,
              "ColorRanking": true
            },
            {
              "title": "可转债",
              "type": "number",
              "id": "convertiblelBondRatio",
              "unit": "%",
              "sorter": true,
              "ColorRanking": true
            },
            {
              "title": "企业债",
              "type": "number",
              "id": "enterpriseBondRatio",
              "unit": "%",
              "sorter": true,
              "ColorRanking": true
            },
            {
              "title": "企业短期融资",
              "type": "number",
              "id": "shortBondRatio",
              "unit": "%",
              "sorter": true,
              "ColorRanking": true
            },
            {
              "title": "中期票据",
              "type": "number",
              "id": "mediumPaperRatio",
              "unit": "%",
              "sorter": true,
              "ColorRanking": true
            },
            {
              "title": "央行票据",
              "type": "number",
              "id": "centralBankPaperRatio",
              "unit": "%",
              "sorter": true,
              "ColorRanking": true
            },
            {
              "title": "同业存单",
              "type": "number",
              "id": "interBankPaperRatio",
              "unit": "%",
              "sorter": true,
              "ColorRanking": true
            }
          ],
          "PivotColumns": true,
          "Notes": "注：红色代表当列中最高值；绿色代表当列中最低值"
        },
        "card": {
          "title": "债券券种配置",
          "width": "24"
        }
      }
    },
    {
      "componentId": "TopBonds",
      "name": "重仓债券",
      "cardTitle": "重仓债券",
      "displayType": "MergedHeader",
      "description": "以表格形式展示{windCodes}基金的重仓债券数据，包括前N大重仓债券名称、占净值比、债券评级，按基金分组展示，报告期：{reportDate}",
      "command": "MFCP.Report19Picker.GetData",
      "params": [
        "windCodes",
        "reportDate"
      ],
      "columns": {
        "Object/FundCode": "windCode",
        "Object/FundName": "name",
        "Object/BondList/BondCode": "bondCode",
        "Object/BondList/BondName": "bondName",
        "Object/BondList/BondValueToFundNet": "proportionToFundNet",
        "Object/BondList/CreditRating": "creditRating"
      },
      "metadata": {
        "MergedHeader": {
          "columns": [
            {
              "title": "",
              "id": "name",
              "children": [
                {
                  "title": "债券名称",
                  "type": "string",
                  "id": "bondName",
                  "href": "!CommandParam(1400,WindCode=$$bondCode)"
                },
                {
                  "title": "占净值比",
                  "type": "number",
                  "id": "proportionToFundNet",
                  "unit": "%"
                },
                {
                  "title": "债券评级",
                  "type": "string",
                  "id": "creditRating"
                }
              ]
            }
          ]
        },
        "card": {
          "title": "重仓债券",
          "width": "24"
        }
      }
    },
    {
      "componentId": "TopFunds",
      "name": "重仓基金",
      "cardTitle": "重仓基金",
      "displayType": "MergedHeader",
      "description": "以表格形式展示{windCodes}基金的重仓基金数据，包括前N大重仓基金名称、持仓市值、占净值比，按基金分组展示，报告期：{reportDate}",
      "command": "PublicFundF9.HoldingFundInfoPicker.GetMultipleRecs",
      "params": [
        "windCodes",
        "reportDate"
      ],
      "columns": {
        "Object/windCode": "windCode",
        "Object/name": "name",
        "Object/holdingFundInfoList/WindCode": "fundCode",
        "Object/holdingFundInfoList/FundName": "fundName",
        "Object/holdingFundInfoList/HoldValue": "marketValue",
        "Object/holdingFundInfoList/NavRatio": "proportionToFundNet"
      },
      "metadata": {
        "MergedHeader": {
          "columns": [
            {
              "title": "",
              "id": "name",
              "children": [
                {
                  "title": "基金名称",
                  "type": "string",
                  "id": "fundName",
                  "href": "!CommandParam(1400,WindCode=$$fundCode)"
                },
                {
                  "title": "持仓市值(亿元)",
                  "type": "number",
                  "id": "marketValue",
                  "sorter": true,
                  "multiply": 1e-08,
                  "fixed": 2
                },
                {
                  "title": "占净值比",
                  "type": "number",
                  "id": "proportionToFundNet",
                  "unit": "%"
                }
              ]
            }
          ]
        },
        "card": {
          "title": "重仓基金",
          "width": "24"
        }
      }
    }
  ]
}