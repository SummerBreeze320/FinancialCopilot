{
  "toolId": "compare_diagnosis",
  "name": "多基金五维能力诊断对比",
  "scope": "COMPARISON",
  "toolType": "COMPARISON_TOOL",
  "description": "对比多只基金的五维能力雷达图分项得分、诊断明细表格及被动指数跟踪误差诊断",
  "provider": "http_invoke",
  "server": null,
  "targetTool": null,
  "templateId": null,
  "parameters": [
    {
      "name": "windCodes",
      "type": "array[string]",
      "required": true,
      "defaultValue": null,
      "description": "入参: windCodes"
    },
    {
      "name": "endDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: endDate"
    },
    {
      "name": "year",
      "type": "string",
      "required": false,
      "defaultValue": "3",
      "description": "入参: year"
    },
    {
      "name": "startDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: startDate"
    }
  ],
  "componentCount": 3,
  "components": [
    {
      "componentId": "AbilityChart",
      "name": "基金诊断得分对比雷达图",
      "cardTitle": "基金诊断",
      "displayType": "chart:radar",
      "description": "以雷达图形式展示{windCodes}基金的诊断得分数据，包括收益能力、抗风险能力、选股择时能力、基金公司得分、基金经理得分，截止日期：{endDate}",
      "command": "report name=Fund.FundComapre.FundScoreCompare21 windcodes={windCodes} year={year} endDate={endDate}",
      "params": [
        "windCodes",
        "endDate",
        "year:3"
      ],
      "columns": {
        "Column0": "windCode",
        "Column1": "name",
        "Column2": "scoreDate",
        "Column3": "scorePeriod",
        "Column4": "profitability",
        "Column5": "riskResistance",
        "Column6": "stockSelectionTimingAbility",
        "Column9": "fundCompanyScore",
        "Column12": "managerScore"
      },
      "metadata": {
        "radar": {
          "columns": {
            "series": {
              "name": [
                "profitability",
                "riskResistance",
                "stockSelectionTimingAbility",
                "fundCompanyScore",
                "managerScore"
              ],
              "label": [
                "收益能力",
                "抗风险能力",
                "选股择时能力",
                "基金公司",
                "基金经理"
              ],
              "labelI18n": {
                "en-US": [
                  "Return Capability",
                  "Risk Resilience",
                  "Security Selection and Market Timing",
                  "Fund Company",
                  "Fund Manager"
                ]
              },
              "fixed": [
                2
              ]
            }
          }
        },
        "card": {
          "title": "基金诊断",
          "width": "12",
          "height": "380px"
        }
      }
    },
    {
      "componentId": "AbilityTable",
      "name": "基金诊断得分对比表格",
      "cardTitle": "基金诊断得分对比表格",
      "displayType": "table",
      "description": "以表格形式展示{windCodes}基金的诊断得分明细数据，包括得分日期、评分周期、总评分、同类排名、收益能力、抗风险能力、选股择时能力、基金公司得分、基金经理得分，截止日期：{endDate}",
      "command": "report name=Fund.FundComapre.FundScoreCompare21 windcodes={windCodes} year={year} endDate={endDate}",
      "params": [
        "windCodes",
        "endDate",
        "year:3"
      ],
      "columns": {
        "Column0": "windCode",
        "Column1": "name",
        "Column2": "scoreDate",
        "Column3": "scorePeriod",
        "Column13": "totalScore",
        "Column14": "totalScoreRank",
        "Column4": "profitability",
        "Column5": "riskResistance",
        "Column6": "stockSelectionTimingAbility",
        "Column9": "fundCompanyScore",
        "Column12": "managerScore"
      },
      "metadata": {
        "table": {
          "columns": [
            {
              "title": "基金名称",
              "type": "string",
              "id": "name",
              "width": "180px"
            },
            {
              "title": "得分日期",
              "type": "string",
              "id": "scoreDate"
            },
            {
              "title": "评分周期",
              "type": "string",
              "id": "scorePeriod"
            },
            {
              "title": "总评分",
              "type": "number",
              "id": "totalScore"
            },
            {
              "title": "同类排名",
              "type": "string",
              "id": "totalScoreRank"
            },
            {
              "title": "收益能力",
              "type": "number",
              "id": "profitability"
            },
            {
              "title": "抗风险能力",
              "type": "number",
              "id": "riskResistance"
            },
            {
              "title": "选股择时能力",
              "type": "number",
              "id": "stockSelectionTimingAbility"
            },
            {
              "title": "基金公司得分",
              "type": "number",
              "id": "fundCompanyScore"
            },
            {
              "title": "基金经理得分",
              "type": "number",
              "id": "managerScore"
            }
          ]
        },
        "card": {
          "show": "ui",
          "title": "基金诊断得分对比表格"
        }
      }
    },
    {
      "componentId": "IndexTrackingDiagnosis",
      "name": "跟踪指数诊断",
      "cardTitle": "跟踪指数诊断",
      "displayType": "table",
      "description": "以表格形式展示{windCodes}指数型基金的跟踪指数诊断数据，包括基金名称、投资类型、跟踪指数、跟踪偏离度阈值、年化跟踪误差阈值、跟踪误差、年化跟踪误差、信息比率和相关系数，区间：{startDate}至{endDate}",
      "command": "Matrix2 functions=f_info_investtype(windcode);f_info_trackindexcode(windcode);f_info_trackindexname(windcode);f_info_trackdeviation_threshold(windcode);f_info_trackerror_threshold(windcode);f_risk_trackerror_trackindex(windcode,{startDate},{endDate},2,1);f_risk_annutrackerror_index(windcode,{startDate},{endDate},2,1);f_risk_inforatio_trackindex(windcode,{startDate},{endDate},2,1,1);f_risk_correcoefficient_trackindex(windcode,{startDate},{endDate},2,1) windcode={windCodes}",
      "params": [
        "windCodes",
        "startDate",
        "endDate"
      ],
      "columns": {
        "Column0": "windCode",
        "Column1": "name",
        "Column2": "investType",
        "Column3": "trackIndexCode",
        "Column4": "trackIndexName",
        "Column5": "trackDeviationThreshold",
        "Column6": "trackErrorThreshold",
        "Column7": "trackError",
        "Column8": "annualizedTrackError",
        "Column9": "informationRatio",
        "Column10": "correlationCoefficient"
      },
      "metadata": {
        "table": {
          "columns": [
            {
              "title": "基金名称",
              "type": "string",
              "id": "name",
              "width": "180px",
              "href": "!CommandParam(1400,WindCode=$$windCode)"
            },
            {
              "title": "投资类型",
              "type": "string",
              "id": "investType"
            },
            {
              "title": "跟踪指数",
              "type": "string",
              "id": "trackIndexName",
              "href": "!CommandParam(1400,WindCode=$$trackIndexCode)"
            },
            {
              "title": "日均跟踪偏离度阈值(业绩基准)",
              "type": "number",
              "id": "trackDeviationThreshold",
              "unit": "%",
              "sorter": true,
              "fixed": 2,
              "colorRanking": false
            },
            {
              "title": "年化跟踪误差阈值(业绩基准)",
              "type": "number",
              "id": "trackErrorThreshold",
              "unit": "%",
              "sorter": true,
              "fixed": 2,
              "colorRanking": false
            },
            {
              "title": "跟踪误差(跟踪指数)",
              "type": "number",
              "id": "trackError",
              "unit": "%",
              "sorter": true,
              "fixed": 2,
              "colorRanking": false
            },
            {
              "title": "跟踪误差(跟踪指数,年化)",
              "type": "number",
              "id": "annualizedTrackError",
              "unit": "%",
              "sorter": true,
              "fixed": 2,
              "colorRanking": false
            },
            {
              "title": "信息比率(跟踪指数)",
              "type": "number",
              "id": "informationRatio",
              "sorter": true,
              "fixed": 2,
              "colorRanking": true
            },
            {
              "title": "相关系数(跟踪指数)",
              "type": "number",
              "id": "correlationCoefficient",
              "sorter": true,
              "fixed": 2,
              "colorRanking": true
            }
          ],
          "extra": [
            {
              "name": [
                "startDate",
                "endDate"
              ],
              "type": "datepicker",
              "datepicker": {
                "YTD": "YTD",
                "近1年": "1Y",
                "近3年": "3Y",
                "近5年": "5Y",
                "日期选择": "custom"
              }
            }
          ],
          "Notes": "注：红色代表当列中最高值；绿色代表当列中最低值"
        },
        "card": {
          "show": "ui",
          "title": "跟踪指数诊断"
        }
      }
    }
  ]
}