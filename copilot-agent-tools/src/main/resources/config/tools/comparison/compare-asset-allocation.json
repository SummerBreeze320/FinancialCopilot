              "NumberRanking": true,
              "fixed": 2
            }
          ],
          "Pivot": true,
          "Notes": "注：①②③:占基金净值比前三名的排名",
          "extra": [
            {
              "name": [
                "industryType"
              ],
              "type": "radio",
              "radio": {
                "证监会行业": 1,
                "Wind一级行业": 4,
                "申万一级行业": 10,
                "中信一级行业": 2
              }
            }
