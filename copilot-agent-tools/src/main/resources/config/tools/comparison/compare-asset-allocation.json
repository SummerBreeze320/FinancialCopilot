{
  "toolId": "compare_asset_allocation",
  "name": "多基金资产与行业配置对比",
  "scope": "COMPARISON",
  "toolType": "COMPARISON_TOOL",
  "description": "横向对比多只基金的大类资产配置、FOF穿透、证监会/申万行业配置明细及 REITs 资产",
  "provider": "http_invoke",
  "server": null,
  "targetTool": null,
  "templateId": null,
  "parameters": [
    {
      "name": "windCodes",
      "type": "array[string]",
      "required": true,
      "defaultValue": null,
      "description": "入参: windCodes"
    },
    {
      "name": "reportDate",
      "type": "string",
      "required": false,
      "defaultValue": null,
      "description": "入参: reportDate"
    },
    {
      "name": "penetrate",
      "type": "string",
      "required": false,
      "defaultValue": "0",
      "description": "入参: penetrate"
    },
    {
      "name": "industryType",
      "type": "string",
      "required": false,
      "defaultValue": "4",
      "description": "入参: industryType"
    }
  ],
  "componentCount": 7,
  "components": [
    {
