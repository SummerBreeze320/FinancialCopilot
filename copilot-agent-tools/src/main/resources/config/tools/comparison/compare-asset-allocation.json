        "Object/CurrencyPortion": "currencyRatio",
        "Object/SecurityPortion": "securityRatio",
        "Object/Other": "otherRatio"
      },
      "metadata": {
        "stackedBar": {
          "columns": {
            "series": {
              "name": [
                "stockRatio",
                "bondRatio",
                "fundRatio",
                "currencyRatio",
                "otherRatio"
              ],
              "xAxis": [
                {
                  "value": "股票",
                  "valueI18n": {
                    "en-US": "Stocks"
                  }
                },
                {
                  "value": "债券",
                  "valueI18n": {
                    "en-US": "Bonds"
                  }
                },
                {
                  "value": "基金",
                  "valueI18n": {
                    "en-US": "Funds"
                  }
                },
                {
                  "value": "现金",
                  "valueI18n": {
                    "en-US": "Cash"
                  }
                },
                {
                  "value": "其他资产",
                  "valueI18n": {
                    "en-US": "Other Assets"
                  }
                }
              ]
