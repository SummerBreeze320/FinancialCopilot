    {
      "componentId": "IndustryAllocationForDefault",
      "name": "行业配置",
      "cardTitle": "行业配置",
      "displayType": "table",
      "description": "以表格形式展示{windCodes}基金的行业配置数据，包括行业名称、行业配置比例，可选证监会、Wind、申万、中信行业分类，报告期：{reportDate}",
