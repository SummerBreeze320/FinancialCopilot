// --- 创建索引 ---
CREATE INDEX fund_code IF NOT EXISTS FOR (f:Fund) ON (f.fund_code);
CREATE INDEX company_id IF NOT EXISTS FOR (c:Company) ON (c.company_id);
CREATE INDEX manager_id IF NOT EXISTS FOR (m:Manager) ON (m.manager_id);
CREATE INDEX stock_code IF NOT EXISTS FOR (s:Stock) ON (s.stock_code);
CREATE INDEX fund_type IF NOT EXISTS FOR (t:FundType) ON (t.name);
CREATE INDEX industry_name IF NOT EXISTS FOR (i:Industry) ON (i.name);
CREATE INDEX futures_code IF NOT EXISTS FOR (f:Futures) ON (f.code);
CREATE INDEX wealth_code IF NOT EXISTS FOR (w:WealthProduct) ON (w.product_code);
CREATE INDEX enterprise_id IF NOT EXISTS FOR (ent:Enterprise) ON (ent.enterprise_id);
