# 基础服务配置
RAG_HOST=0.0.0.0
RAG_PORT=8820

# 数据库 (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:15432/financial_copilot

# 本地 LLM & 多模态 VLM (Codex-Bridge)
OPENAI_BASE_URL=http://127.0.0.1:9090/v1
OPENAI_API_KEY=local-agy
MODEL_NAME=gemini-3.8-flash-low

# 本地 Embedding 服务 (Ollama / Local)
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# 硬件加速与 OCR
ENABLE_GPU_OCR=true
GPU_DEVICE_ID=0

# 重排模型与超参数
RERANKER_TYPE=neural
RERANKER_MODEL_PATH=BAAI/bge-reranker-large
RERANKER_DEVICE=cuda
TOP_K_DEFAULT=5
CANDIDATE_POOL_SIZE=30
RRF_K=60
WEIGHT_VECTOR=0.6
WEIGHT_BM25=0.4
SCORE_THRESHOLD=0.35
